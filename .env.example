# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lang_assessment
DB_USER=postgres
DB_PASSWORD=password123

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars-required

# Gemini API (for question generation)
GEMINI_API_KEY=

# Text-to-Speech Configuration
TTS_PROVIDER=edge
TTS_EDGE_API_URL=http://edge-tts:5001/tts

# Mail Configuration (for scorecard sharing)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@langassessment.com

# Application Configuration
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# CORS Configuration
# Comma-separated list of allowed origins for API requests
# Update this when deploying to a different IP/domain
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend API URL
# IMPORTANT: This is used at build time to configure the frontend's API endpoint
# The browser uses this URL to call backend APIs
# - For localhost development: http://localhost:8080/api
# - For VM/IP deployment: Use the public IP (e.g., http://8.231.125.63:8080/api)
# Note: Must match CORS_ALLOWED_ORIGINS for browser access to work
REACT_APP_API_URL=http://localhost:8080/api
